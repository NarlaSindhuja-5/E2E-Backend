# Database Configuration
DB_HOST=
DB_PORT=3306
DB_NAME=e2e_construction_db
DB_USERNAME=
DB_PASSWORD=
DB_USE_SSL=true

# Security & Authentication
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Public URLs & CORS
FRONTEND_URL=
BACKEND_URL=
APP_CORS_ALLOWED_ORIGINS=

# Server Configuration
SERVER_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# File Storage
FILE_UPLOAD_DIR=uploads/machinery
